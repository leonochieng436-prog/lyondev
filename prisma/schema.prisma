
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  SALES
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUOTED
  CONVERTED
  CLOSED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PricingGroup {
  WEBSITE
  ECOMMERCE
  SOFTWARE
  MOBILE
  ADDON
  CARE
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(EDITOR)
  status       UserStatus  @default(ACTIVE)
  failedAttempts Int       @default(0)
  lockedUntil  DateTime?

  inquiries    Inquiry[]
  notes        InquiryNote[]
  logs         AuditLog[]
  resetTokens  PasswordResetToken[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  userId    String

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String    @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  userId    String?

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)

  services Service[]
}

model Service {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String
  body        String?
  iconName    String?

  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  features    ServiceFeature[]
  status      PublishStatus  @default(PUBLISHED)
  showOnHome  Boolean        @default(true)
  sortOrder   Int            @default(0)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, showOnHome])
}

model ServiceFeature {
  id        String  @id @default(cuid())
  text      String
  sortOrder Int     @default(0)
  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model PricingPackage {
  id            String       @id @default(cuid())
  group         PricingGroup
  name          String
  audience      String?
  priceFromKes  Int
  priceToKes    Int?
  startingFrom  Boolean      @default(false)
  unit          String       @default("one-time")
  recommended   Boolean      @default(false)
  visible       Boolean      @default(true)
  sortOrder     Int          @default(0)

  features      PricingFeature[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([group, visible])
}

model PricingFeature {
  id        String @id @default(cuid())
  text      String
  packageId String

  package PricingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PricingAddon {
  id           String  @id @default(cuid())
  name         String
  priceFromKes Int
  priceToKes   Int?
  unit         String  @default("one-time")
  active       Boolean @default(true)
  sortOrder    Int     @default(0)
}

model Industry {
  id       String            @id @default(cuid())
  name     String            @unique
  summary  String?
  slug     String            @unique

  projects PortfolioProject[]
}

model PortfolioProject {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  summary      String
  category     String

  industryId   String?
  industry     Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)

  coverUrl     String?
  technologies String[]
  challenge    String?
  solution     String?
  results      String?
  liveUrl      String?

  demo         Boolean      @default(false)
  featured     Boolean      @default(false)
  status       PublishStatus @default(DRAFT)

  images       PortfolioImage[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, featured])
}

model PortfolioImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  projectId String

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Testimonial {
  id        String       @id @default(cuid())
  clientName String
  business  String
  avatarUrl String?
  quote     String
  rating    Int?
  status    PublishStatus @default(DRAFT)
  createdAt DateTime     @default(now())
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique

  posts BlogPost[]
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  content        String
  coverUrl       String?

  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, publishedAt])
}

model Inquiry {
  id            String        @id @default(cuid())
  reference     String        @unique
  name          String
  organization  String?
  email         String
  phone         String
  country       String        @default("Kenya")

  service       String
  title         String?
  message       String
  budget        String?
  timeline      String?
  contactMethod String

  status        InquiryStatus @default(NEW)
  archived      Boolean       @default(false)

  assignedToId  String?
  assignedTo    AdminUser?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  notes         InquiryNote[]
  quotes        Quote[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, archived])
  @@index([createdAt])
}

model InquiryNote {
  id        String   @id @default(cuid())
  body      String
  inquiryId String
  authorId  String

  inquiry Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  AdminUser @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model Quote {
  id        String     @id @default(cuid())
  number    String     @unique
  status    QuoteStatus @default(DRAFT)
  validUntil DateTime
  inquiryId String

  inquiry Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  items   QuoteItem[]

  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model QuoteItem {
  id           String @id @default(cuid())
  description  String
  qty          Int    @default(1)
  unitPriceKes Int
  quoteId      String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Consultation {
  id        String             @id @default(cuid())
  type      String
  startsAt  DateTime
  endsAt    DateTime
  name      String
  email     String
  phone     String
  details   String?
  status    ConsultationStatus @default(PENDING)
  notes     String?

  createdAt DateTime @default(now())

  @@index([startsAt, status])
}

model ConsultationAvailability {
  id          String  @id @default(cuid())
  weekday     Int
  startMinute Int
  endMinute   Int
  active      Boolean @default(true)

  @@index([weekday])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  consentAt      DateTime?
  consentVersion String?

  createdAt DateTime @default(now())
}

model PrivacyRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  requestType String
  details     String
  status      String   @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
}
